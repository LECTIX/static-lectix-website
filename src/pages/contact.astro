---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";

const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "0x4AAAAAAEW_pWLNdOrbdsoj";
---

<BaseLayout
  title="Contact — LECTIX"
  description="Consultez les réponses aux questions fréquentes sur les produits LECTIX et signalez une erreur ou un document manquant."
>
  <PageIntro
    eyebrow="Contact"
    title="Une question sur LECTIX ?"
    lead="Les réponses aux demandes les plus fréquentes se trouvent ci-dessous. Le formulaire reste disponible pour signaler une erreur ou proposer un document manquant."
  />
  <section class="faq-section contact-faq" aria-labelledby="questions-frequentes">
    <div class="container two-column-content">
      <div>
        <p class="eyebrow">Avant de nous écrire</p>
        <h2 id="questions-frequentes">Les questions les plus courantes</h2>
      </div>
      <div class="faq-list">
        <details open>
          <summary>Les produits LECTIX sont-ils encore vendus&nbsp;?</summary>
          <p>Non. La société LECTIX est fermée et ne fabrique plus ces produits. Ce site conserve leurs descriptions et leurs fichiers open source, mais ce n’est plus une boutique.</p>
        </details>
        <details>
          <summary>Comment puis-je me procurer un module&nbsp;?</summary>
          <p>LECTIX ne dispose plus de stock et ne connaît pas de revendeur officiel. Un ancien module peut parfois être trouvé d’occasion. Pour les produits open source, une autre possibilité consiste à faire fabriquer la carte à partir des fichiers disponibles sur GitHub.</p>
        </details>
        <details>
          <summary>Je ne connais pas l’électronique. Qui peut m’aider à fabriquer une carte&nbsp;?</summary>
          <p>Un club de modélisme ferroviaire, un fablab ou une personne habituée à l’électronique pourra vous aider à commander le circuit imprimé et à souder les composants. Commencez par lui transmettre le lien GitHub indiqué sur la fiche du produit.</p>
        </details>
        <details>
          <summary>Pouvez-vous réparer mon module ou assurer le service après-vente&nbsp;?</summary>
          <p>Non. Il n’y a plus de service après-vente commercial ni de garantie en cours. Les descriptions, schémas et fichiers open source présents sur le site peuvent toutefois aider une personne compétente à rechercher une panne.</p>
        </details>
        <details>
          <summary>Où trouver les notices et les fichiers techniques&nbsp;?</summary>
          <p>Commencez par la fiche du produit. Lorsqu’une notice française est disponible, un bouton permet de télécharger directement le PDF. Les schémas peuvent aussi être ouverts en grand et imprimés. Le bouton « Accéder aux fichiers techniques » conduit au dossier GitHub pour les plans et programmes.</p>
        </details>
      </div>
    </div>
  </section>
  <section class="content-section contact-section">
    <div class="container contact-grid">
      <div class="contact-aside">
        <p class="eyebrow">Nous écrire</p>
        <h2>Vous n’avez pas trouvé la réponse&nbsp;?</h2>
        <p>Utilisez le formulaire pour signaler une erreur sur le site, un lien qui ne fonctionne plus ou un document manquant.</p>
        <p>Les demandes de disponibilité, d’achat ou de service après-vente ne pourront pas recevoir de réponse différente de celles indiquées dans la FAQ.</p>
        <p>Votre adresse e-mail reste privée. Elle n’apparaît pas sur le site.</p>
      </div>
      <form class="contact-form" action="/api/contact.php" method="post">
        <div class="form-status form-status-success" hidden data-status="sent" tabindex="-1">Merci, votre message a bien été transmis.</div>
        <div class="form-status form-status-error" hidden data-status="error" tabindex="-1">Le message n’a pas pu être envoyé. Réessayez un peu plus tard.</div>
        <div class="form-row">
          <label for="name">Nom</label>
          <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
        </div>
        <div class="form-row">
          <label for="email">Adresse e-mail</label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="190" />
        </div>
        <div class="form-row">
          <label for="subject">Sujet</label>
          <input id="subject" name="subject" type="text" required maxlength="160" />
        </div>
        <div class="form-row">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="8" required maxlength="6000"></textarea>
        </div>
        <div class="honeypot" aria-hidden="true">
          <label for="website">Votre site web</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="form_started" value="0" data-form-started />
        {
          turnstileSiteKey ? (
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact" data-theme="light" />
          ) : (
            <p class="setup-note">Le formulaire sera activé après configuration de la clé Turnstile sur l’environnement Hostinger.</p>
          )
        }
        <button class="button" type="submit" disabled={!turnstileSiteKey}>Envoyer le message</button>
        <p class="form-privacy">Les informations saisies servent uniquement à répondre à votre message. Elles ne sont pas envoyées à PostHog.</p>
      </form>
    </div>
  </section>
  {
    turnstileSiteKey && (
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
    )
  }
  <script>
    const startedInput = document.querySelector<HTMLInputElement>("[data-form-started]");
    if (startedInput) startedInput.value = Math.floor(Date.now() / 1000).toString();

    const status = new URLSearchParams(window.location.search).get("status");
    const statusBox = status ? document.querySelector<HTMLElement>(`[data-status="${status}"]`) : null;
    if (statusBox) {
      statusBox.hidden = false;
      statusBox.focus();
    }
  </script>
</BaseLayout>

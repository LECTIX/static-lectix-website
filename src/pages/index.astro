---
import BaseLayout from "../layouts/BaseLayout.astro";
import { featuredProducts } from "../data/products";
import ProductCard from "../components/ProductCard.astro";
---

<BaseLayout
  title="LECTIX — Produits électroniques pour le train miniature"
  description="Retrouvez les produits électroniques LECTIX, leurs notices, leurs plans et leurs fichiers de fabrication."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Électronique pour le train miniature</p>
        <h1>Des modules électroniques pour votre <span>réseau miniature</span></h1>
        <p>
          LECTIX a conçu des cartes simples à utiliser pour alimenter et automatiser les réseaux de trains miniatures.
          Ce site rassemble les produits, les notices, les plans et les fichiers utiles.
        </p>
        <div class="button-row">
          <a class="button" href="/produits/">Voir les produits</a>
          <a class="button secondary" href="/open-source/">Télécharger les plans et fichiers</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <img
          src="/images/relais-temporise.webp"
          alt=""
          width="1200"
          height="1200"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="help-section" aria-labelledby="aide-navigation">
    <div class="container">
      <h2 id="aide-navigation">Que pouvez-vous trouver sur ce site&nbsp;?</h2>
      <div class="help-grid">
        <article>
          <h3>Les produits LECTIX</h3>
          <p>Une fiche simple pour chaque produit, avec son rôle et ses principales caractéristiques.</p>
          <a href="/produits/">Voir les produits</a>
        </article>
        <article>
          <h3>Les notices et les plans</h3>
          <p>Les documents utiles pour comprendre, réparer ou refaire les cartes électroniques.</p>
          <a href="/open-source/">Voir les documents disponibles</a>
        </article>
        <article>
          <h3>Un formulaire de contact</h3>
          <p>Pour poser une question ou signaler une erreur dans une fiche ou un document.</p>
          <a href="/contact/">Nous contacter</a>
        </article>
      </div>
    </div>
  </section>

  <section class="product-section" aria-labelledby="produits-phares">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Catalogue en cours de remise en ligne</p>
          <h2 id="produits-phares">Les premières fiches disponibles</h2>
        </div>
        <a class="text-link" href="/produits/">Voir la liste des produits</a>
      </div>
      <div class="product-grid">
        {
          featuredProducts.map((product) => (
            <ProductCard product={product} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

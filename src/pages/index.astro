---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { products } from "../data/products";

const highlightedCodes = ["LEC000042", "LEC001020", "LEC008011"];
const highlightedProducts = highlightedCodes.flatMap((code) => {
  const product = products.find((candidate) => candidate.code === code);
  return product ? [product] : [];
});
---

<BaseLayout
  title="LECTIX — Produits électroniques pour le train miniature"
  description="Découvrez les modules électroniques open source LECTIX, conçus pour les automatismes et le modélisme ferroviaire."
>
  <section class="hero">
    <div class="container hero-grid hero-grid-single">
      <div class="hero-copy">
        <p class="eyebrow">Électronique open source pour le modélisme ferroviaire</p>
        <h1>Des automatismes simples pour votre <span>réseau de train miniature</span></h1>
        <p>
          LECTIX est une gamme de modules électroniques conçus pour le modélisme ferroviaire.
          Ils permettent de détecter les trains, gérer un cantonnement, créer des arrêts automatiques et animer le décor.
        </p>
        <div class="button-row">
          <a class="button" href="/produits/">Choisir un produit</a>
          <a class="button secondary" href="/open-source/">Accéder aux fichiers techniques</a>
        </div>
      </div>
    </div>
  </section>

  <section class="help-section" aria-labelledby="aide-navigation">
    <div class="container">
      <h2 id="aide-navigation">Que souhaitez-vous faire sur votre réseau&nbsp;?</h2>
      <div class="help-grid">
        <article>
          <h3>Réaliser un cantonnement</h3>
          <p>Espacez automatiquement plusieurs trains en commandant l’arrêt du convoi qui arrive derrière un canton occupé.</p>
          <a href="/usages/#cantonnement-dcc">Voir les solutions de cantonnement</a>
        </article>
        <article>
          <h3>Détecter le passage d’un train</h3>
          <p>Repérez un train sur une zone de voie ou détectez son passage sans contact avec un capteur infrarouge.</p>
          <a href="/usages/#detecter-occupation">Voir les solutions de détection</a>
        </article>
        <article>
          <h3>Commander la signalisation</h3>
          <p>Faites changer automatiquement un feu selon l’occupation de la voie ou l’état du canton suivant.</p>
          <a href="/usages/#signalisation">Voir les solutions de signalisation</a>
        </article>
        <article>
          <h3>Arrêter un train automatiquement</h3>
          <p>Faites ralentir, arrêter puis redémarrer progressivement un train équipé d’un décodeur DCC compatible.</p>
          <a href="/usages/#arret-signal">Voir les solutions d’arrêt</a>
        </article>
        <article>
          <h3>Faire circuler une navette</h3>
          <p>Automatisez les allers-retours d’un train analogique ou d’un funiculaire entre deux extrémités de voie.</p>
          <a href="/usages/#navette">Voir la solution de navette</a>
        </article>
        <article>
          <h3>Animer le décor</h3>
          <p>Commandez un éclairage pendant une durée choisie ou déclenchez des sons d’ambiance sur le réseau.</p>
          <a href="/usages/#son-automatique">Voir les solutions d’animation</a>
        </article>
      </div>
      <p class="help-all-link"><a class="button secondary" href="/usages/">Voir tous les usages possibles</a></p>
    </div>
  </section>

  <section class="product-section" aria-labelledby="produits-selectionnes">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Produits à découvrir</p>
          <h2 id="produits-selectionnes">Pour détecter, arrêter et sonoriser votre réseau</h2>
        </div>
        <a class="text-link" href="/produits/">Voir les 16 produits</a>
      </div>
      <div class="product-grid">
        {highlightedProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="callout-section" aria-labelledby="fichiers-open-source">
    <div class="container callout-inner">
      <div>
        <p class="eyebrow">Open source</p>
        <h2 id="fichiers-open-source">Les notices, plans et programmes restent disponibles.</h2>
        <p>Lorsqu’une notice française existe, vous pouvez la télécharger directement depuis la fiche du produit. Les autres fichiers techniques sont conservés sur GitHub.</p>
      </div>
      <div class="button-row">
        <a class="button" href="/produits/">Consulter les fiches produits</a>
        <a class="button secondary" href="/open-source/">Voir les fichiers open source</a>
      </div>
    </div>
  </section>
</BaseLayout>

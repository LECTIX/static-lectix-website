---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { products } from "../data/products";

const highlightedCodes = ["LEC000042", "LEC001020", "LEC008011"];
const highlightedProducts = highlightedCodes.flatMap((code) => {
  const product = products.find((candidate) => candidate.code === code);
  return product ? [product] : [];
});
---

<BaseLayout
  title="LECTIX — Produits électroniques pour le train miniature"
  description="Découvrez les modules électroniques open source LECTIX, conçus pour les automatismes et le modélisme ferroviaire."
>
  <section class="hero home-hero">
    <img
      class="home-hero-image"
      src="/images/hero-reseau-miniature.webp"
      alt="Réseau de train miniature éclairé de nuit"
      width="2200"
      height="1970"
      fetchpriority="high"
    />
    <div class="container home-hero-inner">
      <div class="hero-copy home-hero-copy">
        <p class="eyebrow">Électronique open source pour le modélisme ferroviaire</p>
        <h1>Donnez vie à votre réseau de train miniature.</h1>
        <p>
          Détection, cantonnement, arrêts automatiques et animations&nbsp;: les modules LECTIX sont simples à utiliser et entièrement open source.
        </p>
        <div class="button-row">
          <a class="button" href="/usages/">Trouver une solution</a>
          <a class="button secondary" href="/produits/">Voir les produits</a>
        </div>
      </div>
    </div>
  </section>

  <section class="help-section" aria-labelledby="aide-navigation">
    <div class="container">
      <div class="home-section-heading">
        <p class="eyebrow">Selon votre projet</p>
        <h2 id="aide-navigation">Que souhaitez-vous faire sur votre réseau&nbsp;?</h2>
      </div>
      <div class="home-usage-grid">
        <a class="home-usage-card home-usage-card-wide" href="/usages/#cantonnement-dcc">
          <img src="/images/usage-cantonnement.webp" alt="Locomotive miniature devant un signal ferroviaire" width="1600" height="1053" loading="lazy" />
          <span><strong>Réaliser un cantonnement</strong><small>Espacer automatiquement les trains</small></span>
        </a>
        <a class="home-usage-card" href="/usages/#detecter-occupation">
          <img src="/images/detecteur-occupation-analogique.webp" alt="Module de détection d’occupation LECTIX" width="600" height="600" loading="lazy" />
          <span><strong>Détecter un train</strong><small>Sur une zone de voie ou à son passage</small></span>
        </a>
        <a class="home-usage-card" href="/usages/#son-automatique">
          <img src="/images/usage-animation-decor.webp" alt="Bâtiment miniature éclairé" width="1200" height="900" loading="lazy" />
          <span><strong>Animer le décor</strong><small>Éclairage et ambiance sonore</small></span>
        </a>
      </div>
      <p class="help-all-link"><a class="text-link" href="/usages/">Découvrir tous les usages <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="product-section" aria-labelledby="produits-selectionnes">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Trois essentiels</p>
          <h2 id="produits-selectionnes">Des modules conçus pour le train miniature.</h2>
        </div>
        <a class="text-link" href="/produits/">Voir les 16 produits</a>
      </div>
      <div class="product-grid home-product-grid">
        {highlightedProducts.map((product) => <ProductCard product={product} compact />)}
      </div>
    </div>
  </section>

  <section class="callout-section" aria-labelledby="fichiers-open-source">
    <div class="container home-open-source">
      <img src="/images/modules-installes-reseau.webp" alt="Modules LECTIX installés sous un réseau miniature" width="1200" height="555" loading="lazy" />
      <div class="home-open-source-copy">
        <p class="eyebrow">Open source</p>
        <h2 id="fichiers-open-source">Notices, plans et programmes sont disponibles librement.</h2>
        <a class="text-link" href="/open-source/">Accéder aux fichiers open source <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { featuredProducts } from "../data/products";
import ProductCard from "../components/ProductCard.astro";
---

<BaseLayout
  title="LECTIX — Produits électroniques pour le train miniature"
  description="Découvrez les produits électroniques LECTIX : simples à utiliser, accessibles à tous et open source."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Simple · Accessible à tous · Open source</p>
        <h1>L’électronique simple et <span>open source</span> pour votre réseau miniature</h1>
        <p>
          Les produits LECTIX ont été conçus pour être faciles à installer et à comprendre, même sans être spécialiste en électronique.
          Leurs notices, leurs plans et leurs programmes sont disponibles gratuitement.
        </p>
        <div class="button-row">
          <a class="button" href="/produits/">Voir les produits</a>
          <a class="button secondary" href="/open-source/">Comprendre l’open source</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <img
          src="/images/relais-temporise.webp"
          alt=""
          width="1200"
          height="1200"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="help-section" aria-labelledby="aide-navigation">
    <div class="container">
      <h2 id="aide-navigation">Des produits simples, accessibles et open source</h2>
      <div class="help-grid">
        <article>
          <h3>Simples à utiliser</h3>
          <p>Chaque produit répond à un besoin précis du réseau miniature, avec des branchements et des réglages aussi simples que possible.</p>
          <a href="/produits/">Voir les produits</a>
        </article>
        <article>
          <h3>Accessibles à tous</h3>
          <p>Les fiches et les notices sont présentées clairement. Il n’est pas nécessaire de savoir programmer pour les consulter.</p>
          <a href="/produits/">Consulter les 16 fiches</a>
        </article>
        <article>
          <h3>Open source</h3>
          <p>Les plans et les programmes sont publics. Vous pouvez les télécharger pour comprendre, réparer ou refaire un produit.</p>
          <a href="/open-source/">En savoir plus sur l’open source</a>
        </article>
      </div>
    </div>
  </section>

  <section class="product-section" aria-labelledby="produits-phares">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Quelques produits LECTIX</p>
          <h2 id="produits-phares">Trois exemples pour commencer</h2>
        </div>
        <a class="text-link" href="/produits/">Voir la liste des produits</a>
      </div>
      <div class="product-grid">
        {
          featuredProducts.map((product) => (
            <ProductCard product={product} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page introuvable — LECTIX" description="La page demandée n'existe pas ou a été déplacée.">
  <section class="not-found">
    <div class="container narrow">
      <p class="eyebrow">Erreur 404</p>
      <h1>Cette voie ne mène plus nulle part.</h1>
      <p class="lead">L’ancienne page a peut-être été déplacée pendant la migration du site.</p>
      <div class="button-row">
        <a class="button" href="/produits/">Voir les produits</a>
        <a class="button secondary" href="/">Retour à l’accueil</a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import ProductCard from "../../components/ProductCard.astro";
import { products } from "../../data/products";
import { createProductListStructuredData } from "../../data/seo";
---

<BaseLayout
  title="Les produits LECTIX pour le train miniature"
  description="Consultez les 16 produits électroniques LECTIX pour le train miniature : usages, caractéristiques, notices, schémas et fichiers open source."
  structuredData={createProductListStructuredData(products)}
>
  <PageIntro
    eyebrow="Les produits LECTIX"
    title={`Retrouvez les ${products.length} produits LECTIX.`}
    lead="Les produits sont classés par numéro de référence LEC. Chaque fiche indique les utilisations possibles, les branchements et, lorsqu’elle existe, propose la notice PDF en téléchargement direct."
  />
  <section class="catalog-access-section" aria-labelledby="catalog-access-title">
    <div class="container catalog-access-inner">
      <div>
        <h2 id="catalog-access-title">Un module vous intéresse&nbsp;?</h2>
        <p>Découvrez comment le faire fabriquer à partir des fichiers open source.</p>
      </div>
      <a class="button secondary" href="/open-source/#obtenir-un-module">Comment se procurer un module&nbsp;?</a>
    </div>
  </section>
  <section class="content-section" aria-labelledby="liste-produits">
    <div class="container">
      <div class="catalog-toolbar">
        <h2 id="liste-produits">Produits classés par référence</h2>
        <p>De {products[0]?.code} à {products.at(-1)?.code}</p>
      </div>
      <div class="product-grid">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>
</BaseLayout>

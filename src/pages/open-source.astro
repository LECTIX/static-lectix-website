---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { products } from "../data/products";
---

<BaseLayout
  title="Plans, notices et fichiers à télécharger — LECTIX"
  description="Téléchargez les plans, notices et fichiers disponibles pour les produits LECTIX."
>
  <PageIntro
    eyebrow="Plans et fichiers"
    title="Téléchargez les documents des produits LECTIX."
    lead="Les plans, les listes de composants et les programmes sont disponibles gratuitement. Vous pouvez les consulter pour comprendre un produit, le réparer ou fabriquer votre propre carte."
  />
  <section class="content-section">
    <div class="container two-column-content">
      <div>
        <p class="eyebrow">Contenu des dossiers</p>
        <h2>Quels fichiers sont disponibles&nbsp;?</h2>
      </div>
      <div class="prose">
        <p>Selon le produit, vous trouverez le schéma électronique, le dessin du circuit imprimé, la liste des composants, le programme et la notice.</p>
        <p>Ces documents sont publiés sur GitHub. GitHub est simplement le site utilisé pour ranger et télécharger les fichiers. Chaque dossier précise ce que vous avez le droit de copier ou de modifier.</p>
        <a class="button" href="https://github.com/LECTIX">Voir tous les dossiers LECTIX sur GitHub</a>
      </div>
    </div>
  </section>
  <section class="repository-section">
    <div class="container">
      <p class="eyebrow">Dossiers déjà disponibles</p>
      <div class="repository-list">
        {
          products.filter((product) => product.sourceRepository).map((product) => (
            <a class="repository-row" href={product.sourceRepository}>
              <span><strong>{product.code}</strong> {product.name}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

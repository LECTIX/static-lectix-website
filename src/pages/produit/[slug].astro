---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products, type Product } from "../../data/products";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

type Props = {
  product: Product;
};

const { product } = Astro.props;
---

<BaseLayout title={`${product.name} — LECTIX`} description={product.summary}>
  <section class="product-detail-hero">
    <div class="container product-detail-grid">
      <div class="product-detail-copy">
        <p class="eyebrow">{product.category} · {product.code}</p>
        <div class="archive-badge">Ce produit n’est plus vendu</div>
        <h1>{product.name}</h1>
        <p class="lead">{product.introduction}</p>
        <div class="button-row">
          {
            product.sourceRepository ? (
              <a class="button" href={product.sourceRepository}>Voir les fichiers open source</a>
            ) : (
              <a class="button" href="/produits/">Voir les autres produits</a>
            )
          }
          <a class="button secondary" href="/contact/">Poser une question</a>
        </div>
      </div>
      <div class="product-detail-image">
        <img src={product.image} alt={product.imageAlt} width="1200" height="1200" />
      </div>
    </div>
  </section>
  <section class="content-section">
    <div class="container two-column-content">
      <div>
        <p class="eyebrow">Caractéristiques</p>
        <h2>Ce que fait ce module</h2>
      </div>
      <ul class="feature-list">
        {product.features.map((feature) => <li>{feature}</li>)}
      </ul>
    </div>
  </section>
  <section class="notice-panel">
    <div class="container notice-panel-inner">
      {
        product.sourceRepository ? (
          <div>
            <p class="eyebrow">Fichiers open source</p>
            <h2>Les fichiers de ce produit sont disponibles sur GitHub.</h2>
            <p>Vous pouvez y trouver, selon le produit, les plans, la liste des composants, les fichiers de fabrication ou le programme.</p>
          </div>
        ) : (
          <div>
            <p class="eyebrow">Fiche d’archive</p>
            <h2>Aucun dossier open source n’a encore été identifié pour ce produit.</h2>
            <p>La fiche reste en ligne pour conserver la référence et les principales caractéristiques du produit.</p>
          </div>
        )
      }
      <a class="text-link" href="/produits/">Retour aux produits</a>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products, type Product } from "../../data/products";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

type Props = {
  product: Product;
};

const { product } = Astro.props;
const getIllustrationId = (src: string) => {
  const filename = src.split("/").at(-1)?.replace(/\.[^.]+$/, "") ?? "illustration";
  const subject = filename.replace(/^lec\d+[a-z]?-/i, "");
  return `${product.code.toLowerCase()}-${subject}`;
};
---

<BaseLayout title={`${product.name} — LECTIX`} description={product.summary}>
  <section class="product-detail-hero">
    <div class="container product-detail-grid">
      <div class="product-detail-copy">
        <p class="eyebrow">{product.category} · {product.code}</p>
        <h1>{product.name}</h1>
        <p class="lead">{product.introduction}</p>
        <div class="button-row">
          {product.manual && (
            <a class="button" href={product.manual} download>
              Télécharger la notice PDF{product.manualPages ? ` (${product.manualPages} pages)` : ""}
            </a>
          )}
          {product.sourceRepository && (
            <a class={`button ${product.manual ? "secondary" : ""}`} href={product.sourceRepository}>
              Accéder aux fichiers techniques
            </a>
          )}
        </div>
      </div>
      <div class="product-detail-image">
        <img src={product.image} alt={product.imageAlt} width="1200" height="1200" />
      </div>
    </div>
  </section>
  <section class="content-section">
    <div class="container two-column-content">
      <div>
        <p class="eyebrow">Caractéristiques</p>
        <h2>Les points importants</h2>
      </div>
      <ul class="feature-list">
        {product.features.map((feature) => <li>{feature}</li>)}
      </ul>
    </div>
  </section>
  <section class="product-guide-section" aria-labelledby="guide-produit">
    <div class="narrow">
      <p class="eyebrow">Description détaillée</p>
      <h2 id="guide-produit">Installer et utiliser ce produit</h2>
      <div class="product-guide-list">
        {
          product.details.map((section) => (
            <article class="product-guide-block">
              <h3>{section.title}</h3>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {
                section.bullets && (
                  <ul>
                    {section.bullets.map((item) => <li>{item}</li>)}
                  </ul>
                )
              }
              {section.warning && <p class="product-warning"><strong>À retenir :</strong> {section.warning}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </section>
  {
    product.gallery.length > 0 && (
      <section class="product-gallery-section" aria-labelledby="illustrations-produit">
        <div class="container">
          <p class="eyebrow">Schémas et exemples</p>
          <h2 id="illustrations-produit">Voir le produit en situation</h2>
          <p class="gallery-instruction">Cliquez sur un schéma pour l’ouvrir en grand dans une nouvelle page. Vous pourrez ensuite l’imprimer.</p>
          <div class="product-gallery">
            {product.gallery.map((image) => (
              <figure>
                <a href={`/schema/${getIllustrationId(image.src)}/`} target="_blank" rel="noopener" aria-label={`${image.caption} — ouvrir en grand dans une nouvelle page`}>
                  <img src={image.src} alt={image.alt} loading="lazy" />
                  <span class="schema-action">Ouvrir en grand et imprimer <span aria-hidden="true">↗</span></span>
                </a>
                <figcaption>{image.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }
  {
    product.sourceRepository && (
      <section class="notice-panel">
        <div class="container notice-panel-inner">
          <div>
            <p class="eyebrow">Pour aller plus loin</p>
            <h2>Plans et fichiers de fabrication</h2>
            <p>Le dossier GitHub rassemble les fichiers techniques disponibles pour réparer, modifier ou refaire ce produit.</p>
          </div>
          <a class="button" href={product.sourceRepository}>Ouvrir le dossier GitHub</a>
        </div>
      </section>
    )
  }
</BaseLayout>

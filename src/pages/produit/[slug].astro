---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products, type Product } from "../../data/products";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

type Props = {
  product: Product;
};

const { product } = Astro.props;
---

<BaseLayout title={`${product.name} — LECTIX`} description={product.summary}>
  <section class="product-detail-hero">
    <div class="container product-detail-grid">
      <div class="product-detail-copy">
        <p class="eyebrow">{product.category} · {product.code}</p>
        <div class="archive-badge">Ce produit n’est plus vendu</div>
        <h1>{product.name}</h1>
        <p class="lead">{product.introduction}</p>
        <div class="button-row">
          {
            product.sourceRepository ? (
              <a class="button" href={product.sourceRepository}>Télécharger les plans et fichiers</a>
            ) : (
              <a class="button" href="/open-source/">Voir les documents disponibles</a>
            )
          }
          <a class="button secondary" href="/contact/">Poser une question</a>
        </div>
      </div>
      <div class="product-detail-image">
        <img src={product.image} alt={product.imageAlt} width="1200" height="1200" />
      </div>
    </div>
  </section>
  <section class="content-section">
    <div class="container two-column-content">
      <div>
        <p class="eyebrow">Caractéristiques</p>
        <h2>Ce que fait ce module</h2>
      </div>
      <ul class="feature-list">
        {product.features.map((feature) => <li>{feature}</li>)}
      </ul>
    </div>
  </section>
  <section class="notice-panel">
    <div class="container notice-panel-inner">
      <div>
        <p class="eyebrow">Documents en cours de préparation</p>
        <h2>Les notices et les schémas seront ajoutés prochainement.</h2>
        <p>Chaque document est vérifié avant sa mise en ligne afin d’éviter les erreurs et les mauvaises versions.</p>
      </div>
      <a class="text-link" href="/produits/">Retour aux produits</a>
    </div>
  </section>
</BaseLayout>

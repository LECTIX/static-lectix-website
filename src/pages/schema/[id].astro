---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products, type Product } from "../../data/products";
import { getIllustrationDownloadSrc, getIllustrationId, getProductImages, type ProductImage } from "../../data/productDetails";
import { createBreadcrumbStructuredData } from "../../data/seo";

type Illustration = {
  id: string;
  product: Product;
  image: ProductImage;
};

export function getStaticPaths() {
  return products.flatMap((product) =>
    getProductImages(product).map((image) => ({
      params: { id: getIllustrationId(product.code, image.src) },
      props: { id: getIllustrationId(product.code, image.src), product, image },
    })),
  );
}

const { product, image } = Astro.props as Illustration;
const illustrationId = getIllustrationId(product.code, image.src);
const downloadSrc = getIllustrationDownloadSrc(product.code, image.src);
const structuredData = {
  "@context": "https://schema.org",
  ...createBreadcrumbStructuredData([
    { name: "Accueil", path: "/" },
    { name: "Produits", path: "/produits/" },
    { name: product.name, path: `/produit/${product.slug}/` },
    { name: image.caption, path: `/schema/${illustrationId}/` },
  ]),
};
---

<BaseLayout
  title={`${image.caption} — ${product.name} — LECTIX`}
  description={image.alt}
  image={image.src}
  imageAlt={image.alt}
  robots="noindex,follow"
  structuredData={structuredData}
>
  <section class="schema-page">
    <div class="container">
      <div class="schema-intro">
        <nav class="breadcrumbs" aria-label="Fil d’Ariane">
          <a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/produits/">Produits</a><span aria-hidden="true">/</span><a href={`/produit/${product.slug}/`}>{product.name}</a>
        </nav>
        <p class="eyebrow">{product.code} · {product.name}</p>
        <h1>{image.caption}</h1>
        <p>Le schéma complet est affiché ci-dessous. Téléchargez-le au format PNG pour le conserver ou l’imprimer depuis votre ordinateur.</p>
        <div class="button-row schema-actions">
          <a class="button" href={downloadSrc} download={`${illustrationId}.png`}>Télécharger le schéma en PNG</a>
          <a class="button secondary" href={`/produit/${product.slug}/`}>Revenir à la fiche produit</a>
        </div>
        <p class="schema-print-help">Pour l’imprimer, ouvrez le fichier téléchargé puis choisissez « Imprimer » dans le menu de votre ordinateur.</p>
      </div>
      <figure class="schema-sheet">
        <img src={image.src} alt={image.alt} />
        <figcaption>{image.caption}</figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>

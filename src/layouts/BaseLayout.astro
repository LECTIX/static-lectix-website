---
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";

type Props = {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "article";
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title,
  description,
  image = "/images/hero-reseau-miniature.webp",
  imageAlt = "Produits électroniques LECTIX pour le modélisme ferroviaire",
  ogType = "website",
  robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1",
  structuredData,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replaceAll("<", "\\u003c")
  : undefined;

const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f4f0e9" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="LECTIX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {serializedStructuredData && <script is:inline type="application/ld+json" set:html={serializedStructuredData} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="LECTIX — accueil">
          <img src="/images/logo-lectix.webp" alt="LECTIX" width="256" height="51" />
        </a>
        <nav aria-label="Navigation principale">
          <a href="/" aria-current={isCurrent("/") ? "page" : undefined}>Accueil</a>
          <a href="/usages/" aria-current={isCurrent("/usages/") ? "page" : undefined}>Usages</a>
          <a href="/produits/" aria-current={isCurrent("/produits/") || isCurrent("/produit/") ? "page" : undefined}>Produits</a>
          <a href="/open-source/" aria-current={isCurrent("/open-source/") ? "page" : undefined}>Open source</a>
          <a href="/a-propos/" aria-current={isCurrent("/a-propos/") ? "page" : undefined}>À propos</a>
          <a href="/contact/" aria-current={isCurrent("/contact/") ? "page" : undefined}>Contact</a>
        </nav>
      </div>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <img src="/images/logo-lectix.webp" alt="LECTIX" width="192" height="39" />
          <p>Des produits électroniques simples, accessibles et open source pour le train miniature.</p>
        </div>
        <div class="footer-links">
          <a href="/">Accueil</a>
          <a href="/usages/">Usages</a>
          <a href="/produits/">Produits</a>
          <a href="/open-source/">Open source</a>
          <a href="/contact/">Contact</a>
          <a href="/informations-legales/">Informations légales</a>
        </div>
      </div>
      <div class="container footer-bottom">© {year} LECTIX · Contenus et matériels publiés selon les licences indiquées dans chaque dépôt.</div>
    </footer>
    <Analytics />
  </body>
</html>
